{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agensfield.dev/mektup/contracts/event-v1.schema.json",
  "title": "Mektup v1 JSONL lifecycle event",
  "type": "object",
  "required": [
    "schema",
    "event",
    "eventId",
    "sequence",
    "operationId",
    "timestamp",
    "terminal",
    "ok",
    "warnings",
    "data"
  ],
  "properties": {
    "schema": { "const": "mektup/event/v1" },
    "event": {
      "type": "string",
      "enum": [
        "delivery.retrying",
        "send.accepted",
        "reply.accepted",
        "reply.observed",
        "wait.started",
        "wait.incomplete",
        "wait.interrupted",
        "operation.rejected",
        "operation.unknown",
        "operation.failed",
        "operation.completed",
        "operation.progress",
        "operation.cleanup_warning",
        "artifact.spilled",
        "doctor.completed",
        "storage.completed",
        "rpc.completed",
        "thread.list.completed",
        "thread.read.completed",
        "thread.turns.completed",
        "thread.items.completed",
        "search.completed",
        "inspect.completed",
        "receipt.list",
        "receipt.show",
        "receipt.content",
        "receipt.reconciled",
        "receipt.resolved",
        "endpoint.list.completed",
        "endpoint.show.completed",
        "endpoint.add.completed",
        "endpoint.remove.completed",
        "endpoint.check.completed",
        "thread.start.completed",
        "thread.resume.completed",
        "thread.fork.completed",
        "reply.unknown",
        "compact_output_too_large",
        "compact.decode_failed"
      ]
    },
    "eventId": { "$ref": "common-v1.schema.json#/$defs/eventId" },
    "sequence": { "type": "integer", "minimum": 1 },
    "operationId": { "$ref": "common-v1.schema.json#/$defs/operationId" },
    "timestamp": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "terminal": { "type": "boolean" },
    "ok": { "type": "boolean" },
    "warnings": {
      "type": "array",
      "items": { "$ref": "warning-v1.schema.json" }
    },
    "presentation": { "const": "compact" },
    "warningCount": { "type": "integer", "minimum": 0 },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "presentation": { "const": "compact" },
          "event": { "enum": ["thread.list.completed", "thread.turns.completed", "thread.items.completed", "search.completed", "receipt.list"] }
        },
        "required": ["presentation", "event"]
      },
      "then": { "properties": { "data": { "$ref": "compact-v1.schema.json#/$defs/page" } } }
    },
    {
      "if": {
        "properties": { "presentation": { "const": "compact" }, "event": { "const": "inspect.completed" } },
        "required": ["presentation", "event"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["receiptsPage"],
            "properties": { "receiptsPage": { "$ref": "compact-v1.schema.json#/$defs/page" } }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
