{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agensfield.dev/mektup/contracts/control-v1.schema.json",
  "title": "Mektup custody control document v1",
  "description": "Mektup specification revision 1.0.4 metadata-only stdin protocol for fenced custody claim, observation, and reconciliation. Observe is tokenless native-item evidence and never carries dispatch authority. A claim request cannot choose a fencing token or current lease; a claim result uses an explicit claimed|existing union. Heartbeat, commit, and abandon requests must present the issued values. Receipt identity is optional because operation plus original/reply message identity is the custody authority. This protocol never carries a local path, executable path, shell fragment, or reply body.",
  "type": "object",
  "required": ["schema", "kind", "operation", "operationId", "replyMessageId", "originalMessageId", "custody", "replyDestination"],
  "properties": {
    "schema": { "const": "mektup/control/v1" },
    "kind": { "enum": ["request", "result"] },
    "operation": {
      "enum": ["claim", "heartbeat", "commit", "abandon", "status", "reconcile", "observe"]
    },
    "operationId": { "$ref": "common-v1.schema.json#/$defs/operationId" },
    "receiptId": { "$ref": "common-v1.schema.json#/$defs/receiptId" },
    "replyMessageId": { "$ref": "common-v1.schema.json#/$defs/messageId" },
    "originalMessageId": { "$ref": "common-v1.schema.json#/$defs/messageId" },
    "custody": {
      "type": "object",
      "required": ["endpointId", "storeId"],
      "properties": {
        "endpointId": { "$ref": "common-v1.schema.json#/$defs/endpointId" },
        "storeId": { "$ref": "common-v1.schema.json#/$defs/storeId" }
      },
      "additionalProperties": true
    },
    "replyDestination": {
      "type": "object",
      "required": ["endpointId", "threadId", "uri"],
      "properties": {
        "endpointId": { "$ref": "common-v1.schema.json#/$defs/endpointId" },
        "threadId": { "$ref": "common-v1.schema.json#/$defs/threadId" },
        "uri": { "$ref": "common-v1.schema.json#/$defs/uri" }
      },
      "additionalProperties": true
    },
    "bodyBytes": { "type": "integer", "minimum": 0 },
    "bodySha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "replyStatus": { "enum": ["success", "error"] },
    "replyErrorCode": { "type": "string", "minLength": 1 },
    "requestedLease": {
      "type": "object",
      "required": ["durationMs"],
      "properties": {
        "durationMs": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "fencingToken": { "type": "string", "minLength": 1 },
    "lease": {
      "type": "object",
      "required": ["expiresAt"],
      "properties": {
        "acquiredAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "expiresAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "heartbeatAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": true
    },
    "attemptOwner": { "type": "string", "minLength": 1 },
    "requestedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "nativeItemId": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "properties": {
        "disposition": { "enum": ["claimed", "existing"] },
        "state": { "$ref": "common-v1.schema.json#/$defs/state" },
        "fencingToken": { "type": "string", "minLength": 1 },
        "lease": {
          "type": "object",
          "required": ["expiresAt"],
          "properties": {
            "acquiredAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
            "expiresAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
            "heartbeatAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" }
          },
          "additionalProperties": true
        },
        "status": { "type": "string", "minLength": 1 },
        "winner": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["kind", "operation"],
        "properties": {
          "kind": { "const": "request" },
          "operation": { "enum": ["claim", "heartbeat", "commit", "abandon"] }
        }
      },
      "then": {
        "required": ["bodyBytes", "bodySha256", "replyStatus", "attemptOwner"]
      }
    },
    {
      "if": {
        "required": ["kind", "operation"],
        "properties": {
          "kind": { "const": "request" },
          "operation": { "const": "observe" }
        }
      },
      "then": {
        "required": ["nativeItemId", "bodyBytes", "bodySha256", "replyStatus"],
        "not": {
          "anyOf": [
            { "required": ["fencingToken"] },
            { "required": ["lease"] },
            { "required": ["requestedLease"] },
            { "required": ["attemptOwner"] }
          ]
        },
        "allOf": [
          {
            "if": { "required": ["replyErrorCode"] },
            "then": { "properties": { "replyStatus": { "const": "error" } } }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["kind", "operation"],
        "properties": {
          "kind": { "const": "request" },
          "operation": { "enum": ["heartbeat", "commit", "abandon"] }
        }
      },
      "then": {
        "required": ["fencingToken", "lease"],
        "not": { "required": ["requestedLease"] }
      }
    },
    {
      "if": {
        "required": ["kind", "operation"],
        "properties": {
          "kind": { "const": "request" },
          "operation": { "const": "claim" }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["fencingToken"] },
            { "required": ["lease"] },
            { "required": ["result"] }
          ]
        }
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "result" } }
      },
      "then": {
        "required": ["result"],
        "not": {
          "anyOf": [
            { "required": ["fencingToken"] },
            { "required": ["lease"] }
          ]
        }
      }
    },
    {
      "if": {
        "required": ["kind", "operation"],
        "properties": {
          "kind": { "const": "result" },
          "operation": { "const": "claim" }
        }
      },
      "then": {
        "properties": {
          "result": {
            "required": ["disposition"],
            "allOf": [
              {
                "if": { "properties": { "disposition": { "const": "claimed" } } },
                "then": { "required": ["state", "fencingToken", "lease"] }
              },
              {
                "if": { "properties": { "disposition": { "const": "existing" } } },
                "then": {
                  "required": ["state"],
                  "not": { "anyOf": [{ "required": ["fencingToken"] }, { "required": ["lease"] }] }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["kind", "operation"],
        "properties": {
          "kind": { "const": "result" },
          "operation": { "const": "observe" }
        }
      },
      "then": {
        "required": ["result"],
        "not": {
          "anyOf": [
            { "required": ["fencingToken"] },
            { "required": ["lease"] },
            { "required": ["requestedLease"] },
            { "required": ["attemptOwner"] }
          ]
        },
        "properties": {
          "result": {
            "required": ["state"],
            "not": { "anyOf": [{ "required": ["fencingToken"] }, { "required": ["lease"] }] },
            "properties": {
              "status": { "type": "string", "minLength": 1 },
              "winner": { "type": "object" }
            }
          }
        }
      }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["body"] },
      { "required": ["bodyText"] },
      { "required": ["bodyContent"] },
      { "required": ["path"] },
      { "required": ["executable"] },
      { "required": ["shell"] }
    ]
  },
  "additionalProperties": true
}
