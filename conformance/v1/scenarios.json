{
  "schema": "mektup/conformance/v1/scenarios",
  "version": "1.0.0",
  "specVersion": "1.0.3",
  "source": "acceptance-v1.md",
  "profiles": {
    "plain_accept": {
      "transitions": ["intent.persisted", "dispatch.started", "delivery.accepted"],
      "terminal": { "event": "send.accepted", "exit": 0, "state": "accepted" }
    },
    "reply_wait_success": {
      "transitions": ["intent.persisted", "dispatch.started", "delivery.accepted", "reply.claimed", "reply.accepted"],
      "terminal": { "event": "reply.accepted", "exit": 0, "state": "reply_accepted" }
    },
    "rejected": {
      "transitions": ["intent.persisted", "dispatch.started", "delivery.rejected"],
      "terminal": { "event": "operation.rejected", "exit": 3, "state": "rejected" }
    },
    "usage_rejected": {
      "transitions": [],
      "terminal": { "event": "operation.failed", "exit": 2, "state": "not_sent" }
    },
    "not_sent_recovered": {
      "transitions": ["intent.persisted", "recovery.prepared_orphan"],
      "terminal": { "event": "operation.failed", "exit": 1, "state": "not_sent" }
    },
    "unknown": {
      "transitions": ["intent.persisted", "dispatch.started", "transport.result_lost"],
      "terminal": { "event": "operation.unknown", "exit": 4, "state": "outcome_unknown" }
    },
    "wait_incomplete": {
      "transitions": ["intent.persisted", "dispatch.started", "delivery.accepted", "wait.started"],
      "terminal": { "event": "wait.incomplete", "exit": 5, "state": "accepted" }
    },
    "reply_unknown": {
      "transitions": ["intent.persisted", "dispatch.started", "delivery.accepted", "reply.claimed", "claim.expired"],
      "terminal": { "event": "operation.unknown", "exit": 4, "state": "reply_outcome_unknown" }
    },
    "read_complete": {
      "transitions": [],
      "terminal": { "event": "thread.read.completed", "exit": 0, "state": "accepted" }
    }
  },
  "scenarios": [
